{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "_comment": "One Vercel project serves both hosts. www.indiarecycles.org gets the public site; admin1.indiarecycles.org serves /admin/index.html at its root and is noindex everywhere so it can never compete with the real site in search.",

  "cleanUrls": false,
  "trailingSlash": false,

  "rewrites": [
    {
      "source": "/",
      "has": [{ "type": "host", "value": "admin1.indiarecycles.org" }],
      "destination": "/admin/index.html"
    }
  ],

  "headers": [
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "admin1.indiarecycles.org" }],
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" }
      ]
    },
    {
      "source": "/admin/(.*)",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    },
    {
      "source": "/images/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/(.*).css",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
